{
  "name": "longevity",
  "version": "0.1.0",
  "description": "Repairability scanner for household products: score, spare parts, local repairers and life cost",
  "license": "MIT",
  "type": "module",
  "bin": {
    "longevity": "src/index.ts"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "demo": "tsx src/index.ts demo",
    "serve": "node scripts/serve.mjs web 8080"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "repair",
    "repairability",
    "right-to-repair",
    "ifixit",
    "openstreetmap",
    "sustainability"
  ],
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}